<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>

    <!-- Plugin metadata -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>CS1591</NoWarn>
    <AssemblyVersion>1.5.294.0</AssemblyVersion>
    <FileVersion>1.5.294.0</FileVersion>
    <Version>1.5.294.0</Version>
    <Authors>MCP Capital LLC</Authors>
    <Company>MCP Capital LLC</Company>
    <Description>Synchronize Philips Hue lights with your media playback in real-time.</Description>
    <RepositoryUrl>https://github.com/AnalyticETH/HarmonizeProject-Jellyfin</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Model" Version="10.10.7">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Controller" Version="10.10.7">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <!-- Managed DTLS keeps Hue credentials out of an OpenSSL process command line. -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <!-- Keep the JSON assembly on the .NET 8 servicing line; the plugin package does not
         ship framework assemblies, so a .NET 9 assembly would not load on Jellyfin .NET 8. -->
    <PackageReference Include="System.Text.Json" Version="8.0.6" />
    <PackageReference Include="System.Text.Encodings.Web" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configuration/configPage.html" />
    <None Include="../meta.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>

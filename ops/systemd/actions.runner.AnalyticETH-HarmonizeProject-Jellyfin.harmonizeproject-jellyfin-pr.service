[Unit]
Description=GitHub Actions PR Validation Runner (AnalyticETH-HarmonizeProject-Jellyfin)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=harmonize-pr-runner
Group=harmonize-pr-runner
WorkingDirectory=/var/lib/harmonize-pr-runner/actions-runner
ExecStartPre=/usr/bin/test -f /var/lib/harmonize-pr-runner/actions-runner/.runner
ExecStartPre=/usr/bin/test -r /var/lib/harmonize-pr-runner/actions-runner/.credentials
ExecStartPre=/usr/local/sbin/harmonize-pr-runner-clean
ExecStart=/var/lib/harmonize-pr-runner/actions-runner/runsvc.sh
Environment=HOME=/var/lib/harmonize-pr-runner/home
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=RUNNER_ROOT=/var/lib/harmonize-pr-runner/actions-runner
Environment=ACTIONS_RUNNER_HOOK_JOB_COMPLETED=/usr/local/sbin/harmonize-pr-runner-clean
Environment=XDG_CACHE_HOME=/var/lib/harmonize-pr-runner/cache
Environment=XDG_CONFIG_HOME=/var/lib/harmonize-pr-runner/home/.config
Environment=XDG_DATA_HOME=/var/lib/harmonize-pr-runner/home/.local/share
Environment=DOTNET_CLI_HOME=/var/lib/harmonize-pr-runner/home
Environment=NPM_CONFIG_CACHE=/var/lib/harmonize-pr-runner/cache/npm
Environment=PIP_CACHE_DIR=/var/lib/harmonize-pr-runner/cache/pip
Environment=UV_CACHE_DIR=/var/lib/harmonize-pr-runner/cache/uv
KillMode=control-group
KillSignal=SIGTERM
Restart=on-failure
RestartSec=10s
TimeoutStopSec=5min
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=tmpfs
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RemoveIPC=true
KeyringMode=private
UMask=0077
ReadOnlyPaths=/var/lib/harmonize-pr-runner/actions-runner
ReadWritePaths=/var/lib/harmonize-pr-runner/actions-runner/_work
ReadWritePaths=/var/lib/harmonize-pr-runner/actions-runner/_diag
ReadWritePaths=/var/lib/harmonize-pr-runner/actions-runner/_temp
ReadWritePaths=/var/lib/harmonize-pr-runner/home
ReadWritePaths=/var/lib/harmonize-pr-runner/cache
MemoryMax=8G
MemorySwapMax=8G
TasksMax=2048
CPUQuota=400%
LimitNOFILE=65536
LimitCORE=0

[Install]
WantedBy=multi-user.target
